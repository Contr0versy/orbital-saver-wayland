# Live wallpaper for Wayland compositors with wlr-layer-shell (niri, sway,
# Hyprland, river). Enable with:
#
#   systemctl --user enable --now orbital-background.service
#
# Options go in a drop-in (systemctl --user edit orbital-background.service):
#
#   [Service]
#   ExecStart=
#   ExecStart=@BINDIR@/orbital-background --palette cyber --battery-fps 12

[Unit]
Description=orbital-background live wallpaper
Documentation=https://github.com/Contr0versy/orbital-background
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
ExecStart=@BINDIR@/orbital-background
Restart=on-failure
RestartSec=2

# A wallpaper should never compete with real work, and coarse timer slack
# lets the kernel batch its wake-ups with others.
Nice=10
TimerSlackNSec=5ms

# Optional, measure before keeping either: run only when a CPU is otherwise
# idle, and stay on the low-power cores (12-15 on a Framework 13 with a
# Core Ultra; check /sys/devices/system/cpu/cpu*/cache for your machine).
#CPUSchedulingPolicy=idle
#CPUAffinity=12-15

[Install]
WantedBy=graphical-session.target
