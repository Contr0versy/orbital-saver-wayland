# Maintainer: Contr0versy <143365037+Contr0versy at users dot noreply dot github dot com>
#
# Builds the latest commit on main. To try it locally:
#
#   cd packaging/aur && makepkg -si
#
# To publish on the AUR, this file (plus a generated .SRCINFO) goes into its
# own repository at ssh://aur@aur.archlinux.org/orbital-background-git.git

pkgname=orbital-background-git
pkgver=r0
pkgrel=1
pkgdesc="Retro wireframe solar system Wayland live wallpaper with Keplerian orbits"
arch=('x86_64' 'aarch64')
url="https://github.com/Contr0versy/orbital-background"
license=('MIT')
makedepends=('go' 'git')
provides=('orbital-background')
conflicts=('orbital-background')
source=("orbital-background::git+https://github.com/Contr0versy/orbital-background.git")
sha256sums=('SKIP')

pkgver() {
  cd orbital-background
  (
    set -o pipefail
    git describe --long --tags 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' ||
      printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
  )
}

build() {
  cd orbital-background
  make build VERSION="$pkgver" GOFLAGS='-trimpath -mod=readonly -modcacherw'
}

check() {
  cd orbital-background
  go test ./...
}

package() {
  cd orbital-background
  make install PREFIX=/usr DESTDIR="$pkgdir"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
