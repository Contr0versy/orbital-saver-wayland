<?xml version="1.0" encoding="ISO-8859-1"?>

<!-- Settings dialog description for xscreensaver-settings.
     Installed to /usr/share/xscreensaver/config/. -->

<screensaver name="orbital-saver" _label="Orbital Saver">

  <command arg="--root"/>

  <hgroup>
   <vgroup>
    <number id="speed" type="slider" arg="--speed %"
            _label="Speed" _low-label="Slow" _high-label="Fast"
            low="0.1" high="8.0" default="1.0"/>

    <number id="fps" type="slider" arg="--fps %"
            _label="Frame rate" _low-label="Low" _high-label="High"
            low="10" high="120" default="60"/>

    <number id="stars" type="spinbutton" arg="--stars %"
            _label="Stars" low="0" high="10000" default="1500"/>
   </vgroup>

   <vgroup>
    <select id="palette">
     <option id="amber" _label="Amber phosphor"/>
     <option id="cyber" _label="Cyan and gold" arg-set="--palette cyber"/>
     <option id="mono"  _label="White on black" arg-set="--palette mono"/>
     <option id="green" _label="Green phosphor" arg-set="--palette green"/>
    </select>

    <number id="line-width" type="spinbutton" arg="--line-width %"
            _label="Line width (0 = automatic)" low="0" high="8" default="0"/>
   </vgroup>
  </hgroup>

  <_description>
A minimalist wireframe solar system. Polyhedral planets, a ringed world, moons
and a comet follow elliptical Keplerian orbits around a central star, with
depth-faded lines and a parallax starfield.
  </_description>
</screensaver>
